rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utilisateurs : lecture pour tous, écriture si authentifié
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /User/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Rendez-vous : lecture et écriture pour utilisateurs connectés
    match /appointments/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback : lecture pour tous, écriture si authentifié
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
